# shadjewel.ir - environment example
# cp .env.example .env.local  then fill real values
# Never commit real secrets

# Site
NEXT_PUBLIC_SITE_URL=https://shadjewel.ir
# Public indexing: keep false until catalog/content is ready. robots.ts disallows all until true.
# Set true in Vercel Production when going public: NEXT_PUBLIC_ALLOW_INDEX=true
NEXT_PUBLIC_ALLOW_INDEX=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=shadjewel-media

# Upstash Redis (Rate Limit)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Cron / server security (required for /api/cron/backup, expire-reservations, jobs, orphan-media)
# Generate a long random string and set the same value in Vercel; cron calls use Authorization: Bearer …
CRON_SECRET=change-me-to-a-long-random-string

# OTP (future)
OTP_PEPPER=change-me-to-a-long-random-string
OTP_TTL_SECONDS=300

# SMS (future - Melipayamak etc)
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_BODY_ID=

# SEO optional
INDEXNOW_KEY=

# OpenAI optional
OPENAI_API_KEY=
OPENAI_SEO_MODEL=gpt-4o-mini
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_FROM=
ADMIN_SMS_PHONES=
# OTP login/signup/recovery pattern (approved 592258, single {0}=code). Set in hosting.
MELIPAYAMAK_BODY_OTP_LOGIN=
MELIPAYAMAK_BODY_ORDER_PLACED=
MELIPAYAMAK_BODY_ORDER_NEW_ADMIN=
MELIPAYAMAK_BODY_PAYMENT_SUCCESS=
MELIPAYAMAK_BODY_PAYMENT_FAILED=
MELIPAYAMAK_BODY_SHIPPED=
MELIPAYAMAK_BODY_TRACKING_CODE=
MELIPAYAMAK_BODY_ORDER_CANCELLED=
MELIPAYAMAK_BODY_ADMIN_CRITICAL=

# Transactional email (Resend) — owner must set for order confirmation + stock/price alerts
# Without RESEND_API_KEY, emailOrderPlaced / alert emails fail-soft (skipped). SMS is separate (out of scope).
# Create a key at resend.com; verify your sending domain; EMAIL_FROM must match that domain.
RESEND_API_KEY=
EMAIL_FROM=اکسسوری شاد <noreply@your-domain.com>
# Optional alias (send.ts also reads RESEND_FROM if EMAIL_FROM empty)
# RESEND_FROM=
